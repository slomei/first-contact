# Get your API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Create a bot at https://discord.com/developers/applications — Bot tab → Token
DISCORD_BOT_TOKEN=your-discord-token

# Run the Discord bot once without this set — it prints your ID when you message it
DISCORD_USER_ID=your-discord-id

# Message @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=your-telegram-token

# Run the Telegram bot once without this set — it prints your ID when you message it
TELEGRAM_USER_ID=your-telegram-id

# Optional: for OpenAI provider (set "provider": "openai" in config.json)
# OPENAI_API_KEY=your-openai-key

# Optional: for Gemini provider (set "provider": "gemini" in config.json)
# GEMINI_API_KEY=your-gemini-key

# Search provider API keys (optional — DuckDuckGo works without any key)
# Options: "duckduckgo" (default), "brave" (free tier), "google" (best results), "serpapi" (paid)
# BRAVE_SEARCH_API_KEY=your-key-here
# GOOGLE_SEARCH_API_KEY=your-key-here
# GOOGLE_SEARCH_CX=your-custom-search-engine-id
# SERPAPI_KEY=your-key-here
